        "chapter": "Laws of Motion",
        "topic": "Newton's Second Law",
        "subtopic": "Application of F = ma",
        "class": 11,
        "ncert_chapter_number": 5,
        "ncert_chapter_name": "Laws of Motion",
  
        "difficulty": "Easy",
        "difficulty_score": 1,
  
        "has_question_image": false,
        "question_image_url": null,
        "question_text": "A body of mass $5\\,kg$ is acted upon by a net force of $20\\,N$. The acceleration produced is:",
  
        "options": [
          { "key": "1", "text": "$2\\,m/s^2$", "image_url": null },
          { "key": "2", "text": "$4\\,m/s^2$", "image_url": null },
          { "key": "3", "text": "$10\\,m/s^2$", "image_url": null },
          { "key": "4", "text": "$100\\,m/s^2$", "image_url": null }
        ],
  
        "correct_answer": {
          "type": "single",
          "value": "2"
        },
  
        "solution_text": "Using Newton's second law, $F = ma$. So $a = \\frac{F}{m} = \\frac{20}{5} = 4\\,m/s^2$.",
        "solution_image_url": null,
  
        "tags": ["newton", "force", "acceleration", "class11"],
        "is_previous_year": true,
        "previous_year_ref": "NEET-2023-PHY-Q12"
      },
  
